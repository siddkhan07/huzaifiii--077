
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>Display Error</title>

<style>
* {
    box-sizing: border-box;
}

html, body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #050505;
    font-family: Arial, sans-serif;
}

/* Fake broken screen */

.screen {
    position: fixed;
    inset: 0;
    background:
        linear-gradient(110deg,
            transparent 48%,
            #ffffff55 49%,
            #ffffff55 50%,
            transparent 51%),
        linear-gradient(35deg,
            transparent 48%,
            #ffffff44 49%,
            #ffffff44 50%,
            transparent 51%),
        #111;

    animation: flicker .12s infinite;
}

/* Crack lines */

.crack {
    position: absolute;
    width: 3px;
    background: #fff9;
    transform-origin: top;
    box-shadow: 0 0 5px white;
}

.c1 {
    height: 65%;
    left: 48%;
    top: 0;
    transform: rotate(8deg);
}

.c2 {
    height: 55%;
    left: 48%;
    top: 30%;
    transform: rotate(-35deg);
}

.c3 {
    height: 45%;
    left: 48%;
    top: 20%;
    transform: rotate(55deg);
}

.c4 {
    height: 35%;
    left: 48%;
    top: 55%;
    transform: rotate(-65deg);
}

.c5 {
    height: 30%;
    left: 48%;
    top: 5%;
    transform: rotate(85deg);
}

/* Dark broken patches */

.patch {
    position: absolute;
    background: #000;
    opacity: .8;
}

.p1 {
    width: 180px;
    height: 80px;
    top: 20%;
    left: 5%;
    transform: rotate(-15deg);
}

.p2 {
    width: 150px;
    height: 100px;
    bottom: 15%;
    right: 5%;
    transform: rotate(20deg);
}

/* Message */

.message {
    position: absolute;
    inset: 0;

    display: flex;
    justify-content: center;
    align-items: center;

    text-align: center;

    color: #aaa;
    font-size: 15px;

    opacity: .65;
}

#prank {
    display: none;

    position: fixed;
    left: 50%;
    bottom: 50px;

    transform: translateX(-50%);

    padding: 16px 28px;

    border: none;
    border-radius: 30px;

    background: #ff1744;
    color: white;

    font-size: 18px;
    font-weight: bold;

    box-shadow: 0 0 25px #ff1744;

    cursor: pointer;

    z-index: 10;
}

@keyframes flicker {
    0% {
        filter: brightness(.7);
    }

    50% {
        filter: brightness(.95);
    }

    100% {
        filter: brightness(.65);
    }
}
</style>
</head>

<body>

<div class="screen">

    <!-- Fake cracks -->

    <div class="crack c1"></div>
    <div class="crack c2"></div>
    <div class="crack c3"></div>
    <div class="crack c4"></div>
    <div class="crack c5"></div>

    <!-- Fake damaged areas -->

    <div class="patch p1"></div>
    <div class="patch p2"></div>

    <div class="message">
        <div>
            <h2>⚠ DISPLAY ERROR</h2>
            <p>Screen malfunction detected...</p>
        </div>
    </div>

</div>

<button id="prank" onclick="reveal()">
    😂 PRANK HO GAYA!
</button>


<script>

/* Show prank button after 15 seconds */

setTimeout(() => {

    document.getElementById("prank").style.display = "block";

}, 15000);


/* Reveal */

function reveal() {

    document.body.innerHTML = `

        <div style="
            height:100vh;
            display:flex;
            justify-content:center;
            align-items:center;
            text-align:center;
            background:#111;
            color:white;
            font-family:Arial;
            padding:20px;
        ">

            <div>

                <div style="font-size:80px;">
                    😂
                </div>

                <h1>
                    BHAI PRANK HO GAYA!
                </h1>

                <p style="
                    color:#aaa;
                    font-size:18px;
                ">
                    Teri display bilkul safe hai 😭😂
                </p>

                <button onclick="location.reload()" style="
                    padding:12px 25px;
                    border:0;
                    border-radius:25px;
                    background:#ff1744;
                    color:white;
                    font-weight:bold;
                ">
                    Dobara Dekho 😈
                </button>

            </div>

        </div>
    `;
}

</script>

</body>
</html>

